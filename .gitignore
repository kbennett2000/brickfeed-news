# Personal Claude Code config (permissions) — not shared. This pattern ignores the file both
# in this standalone project and while the folder is still nested inside its origin repo.
.claude/settings.local.json

# The shared engine pin (.claude/settings.json) is intentionally NOT ignored — it travels with
# the repo so every clone runs on the same model/effort.

# cycle runtime
/.factory/
/cycle.log
PAUSE

# node / app
/node_modules/

# local app config (secrets/URLs) — commit config.example.json instead
/config.json

# runtime manifest + artifacts (git-as-database is a later slice's job)
/data/

# generated image bytes for local visual inspection (Slice 3 temporary sink) — never
# committed; images live in storage referenced by URL, never in git (ADR-0001 #5)
/out/

# rendered static site (Slice 7 build artifact) — derived output; the deploy slice decides
# how it's served. Chrome lives as committed SOURCE in src/render/styles.ts, not here.
/site/

# source-of-truth binaries (e.g. the About portrait) — uploaded to Blob and referenced by
# URL, never committed (repo stays text-only, same rule as generated story images).
/assets/

/cron.env
