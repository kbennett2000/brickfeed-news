{
  "feedUrls": [
    "https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en",
    "https://news.google.com/rss/headlines/section/topic/SPORTS?hl=en-US&gl=US&ceid=US:en"
  ],
  "manifestPath": "data/manifest.json",
  "generator": {
    "provider": "claude",
    "model": "claude-haiku-4-5-20251001",
    "opinionModel": "sonnet",
    "grok": {
      "baseUrl": "https://api.x.ai/v1",
      "model": "grok-4.5"
    },
    "grokTerminal": {
      "command": "grok",
      "args": [],
      "timeoutMs": 120000
    },
    "tts": {
      "url": "http://G434:8712",
      "storyCover": false,
      "opinionGate": false,
      "opinionImageBrief": false,
      "timeoutMs": {
        "opinion-gate": 120000
      },
      "retries": 0
    }
  },
  "brickStyle": {
    "styleLanguage": "Rendered as a diorama built from generic plastic toy building bricks: glossy studded pieces, blocky minifigure characters with cylindrical grip hands, arranged on a studded baseplate under soft studio lighting."
  },
  "image": {
    "provider": "grok-terminal",
    "grok": {
      "baseUrl": "https://api.x.ai/v1",
      "model": "grok-imagine-image-quality",
      "aspectRatio": "1:1",
      "resolution": "1k"
    },
    "local": {
      "url": "http://localhost:8189",
      "style": "base"
    },
    "grokTerminal": {
      "command": "grok",
      "args": [],
      "timeoutMs": 180000
    },
    "optimize": {
      "enabled": true,
      "maxEdge": 1280,
      "quality": 80
    }
  },
  "storage": {
    "provider": "blob",
    "blob": {
      "pathPrefix": "images/",
      "publicBaseUrl": "https://your-store-id.public.blob.vercel-storage.com"
    },
    "local": {
      "dir": "site/images",
      "publicBaseUrl": "images"
    }
  },
  "maxAgeHours": 72,
  "opinionMaxAgeHours": 2160,
  "opinionPublishHourUTC": 13,
  "publishedPath": "data/published.json",
  "concurrency": 4,
  "maxStoriesPerCycle": 40,
  "render": {
    "outputDir": "site",
    "secondaryStoryCount": 4,
    "timeZone": "UTC",
    "siteBaseUrl": "https://www.brickfeed.news",
    "analytics": "none",
    "share": {
      "handle": "brickfeednews",
      "hashtags": ["brickfeed", "news"]
    },
    "imageOptimization": {
      "enabled": true,
      "widths": [320, 480, 640, 960, 1280],
      "quality": 75
    }
  },
  "deploy": {
    "command": "vercel --prod --yes",
    "cwd": "site",
    "enabled": true
  },
  "comments": {
    "enabled": true,
    "initialCount": 5,
    "perPassCount": 4,
    "maxPerPiece": 60,
    "growWindowHours": 72,
    "model": "sonnet"
  }
}
